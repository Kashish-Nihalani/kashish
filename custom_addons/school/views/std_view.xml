<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_std_model_tree" model="ir.ui.view">
        <field name="name">std.model.tree</field>
        <field name="model">std.model</field>
        <field name="arch" type="xml">
            <tree>
                <field name="c_id"/>
                <field name="c_name"/>
                <field name="c_sub"/>
                <field name="sub_code"/>
            </tree>
        </field>
    </record>

    <record id="view_std_model_form" model="ir.ui.view">
        <field name="name">std.model.form</field>
        <field name="model">std.model</field>
        <field name="arch" type="xml">
            <form string="Standard">
                <sheet>
                    <group>
                        <field name="c_id"/>
                        <field name="c_name"/>
                        <field name="c_sub"/>
                        <field name="sub_code"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_std_model" model="ir.actions.act_window">
        <field name="name">Standard</field>
        <field name="res_model">std.model</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_std_model_tree"/>
    </record>
</odoo>